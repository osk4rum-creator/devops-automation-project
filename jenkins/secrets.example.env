# EXAMPLE ONLY. Copy to secrets/ghcr.env (gitignored) and fill in real values.
# scripts/install-jenkins.sh turns it into the Kubernetes Secret "jenkins-ghcr",
# which JCasC loads as the Jenkins credential "ghcr".
#
# Token: GitHub -> Settings -> Developer settings -> Personal access tokens ->
#        Tokens (classic) -> scopes: write:packages (includes read:packages)
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_example_not_a_real_token
